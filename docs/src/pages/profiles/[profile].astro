---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { listRecipes, loadRecipe } from '../../lib/profiles.mjs';

export function getStaticPaths() {
  return listRecipes().map((recipe) => {
    const data = loadRecipe(recipe);
    return {
      params: { profile: recipe },
      props: { recipe, data },
    };
  });
}

const { recipe, data } = Astro.props;

const headings = [
  { depth: 2, slug: 'apply', text: 'Apply' },
  { depth: 2, slug: 'builtins', text: 'Builtins' },
  { depth: 2, slug: 'includes', text: 'Includes' },
  { depth: 2, slug: 'config', text: 'config.toml' },
];
---

<StarlightPage
  frontmatter={{
    title: recipe,
    description: data.description,
    editUrl: `https://github.com/mrjk/ai-rules/edit/main/examples/${recipe}/.ai-rulez/config.toml`,
  }}
  headings={headings}
>
  <p>
    Intention recipe: <code>examples/{recipe}/.ai-rulez/config.toml</code>. Copy it into a
    project as <code>.ai-rulez/config.toml</code>, rewrite includes for a git
    <code>source</code> and <code>ref</code>, then generate.
  </p>

  <AnchorHeading level={2} id="apply">Apply</AnchorHeading>
  <pre><code>task apply RECIPE={recipe} TARGET=/path/to/project</code></pre>

  <AnchorHeading level={2} id="builtins">Builtins</AnchorHeading>
  <ul>
    {data.builtins.map((b) => (
      <li>
        <code>{b}</code>
      </li>
    ))}
  </ul>

  <AnchorHeading level={2} id="includes">Includes</AnchorHeading>
  <ul>
    {data.includes.map((name) => (
      <li>
        <code>modules/{name}</code>
      </li>
    ))}
  </ul>

  <AnchorHeading level={2} id="config">config.toml</AnchorHeading>
  <pre><code>{data.raw}</code></pre>
</StarlightPage>
