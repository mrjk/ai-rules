[
  {
    "target": "Codex",
    "ai_workflow": {
      "type": "steps",
      "preamble": "REPLACE ME: one sentence saying what this service does and which framework and datastore it uses. Install with `uv sync`, test with `uv run pytest`, lint with `ruff check .`.",
      "before_start": [
        "sdlc/grounding-docs",
        "sdlc/brownfield-grounding",
        "sdlc/one-command-per-action",
        "sdlc/ci-same-commands",
        "tool-mise/pin-toolchain",
        "tool-task/taskfile-practices",
        "sdlc/pin-versions",
        "security/no-git-leakage",
        "sdlc/dev-setup",
        {
          "slug": "sdlc/project-license",
          "vars": { "project_license": "GPL-3.0-or-later" }
        },
        "git/feature-branch-workflow",
        "sdlc/github-actions-hygiene",
        "sdlc/repo-hygiene",
        "general/ignore-and-secrets-files",
        "workflow/understand-before-changing",
        "general/ask-when-blocked",
        "general/reviewable-increments",
        "general/no-privileged-commands",
        "general/ascii-punctuation",
        "general/config-over-constants"
      ],
      "before_finish": [
        "general/concise-reporting",
        "sdlc/pr-description",
        "workflow/verify-before-completing",
        "git/conventional-commits",
        "git/submodule-sync-commits"
      ],
      "steps": [
        {
          "step_name": "Specify",
          "description": "Turn the request into numbered, testable requirements with explicit non goals.",
          "rules": [
            "role/product-owner",
            "sdlc/write-spec-first",
            "sdlc/numbered-requirements"
          ]
        },
        {
          "step_name": "Design",
          "description": "Choose the shape of the solution and record the decision.",
          "rules": [
            "role/architect",
            "sdlc/adr-for-decisions",
            "architecture/solid-principles",
            "pov/mrjk-python-oop",
            "pov/mrjk-http"
          ]
        },
        {
          "step_name": "Implement",
          "description": "Implement one numbered requirement at a time.",
          "rules": [
            "role/developer",
            "stack/python-web",
            "lang-python/style",
            "lang-python/typing",
            "lang-python/errors",
            "lang-python/logging",
            "lang-python/async",
            "lang-python/time",
            "lang-python/unsafe-apis",
            {
              "slug": "lang-python/packaging",
              "vars": { "python_min_version": "3.11" }
            },
            "tool-python/uv",
            "tool-python/ruff",
            "tool-python/mypy",
            "sdlc/dependency-upgrades",
            {
              "slug": "sdlc/license-on-add",
              "vars": { "project_license": "GPL-3.0-or-later" }
            },
            "sdlc/env-contract",
            "sdlc/timeouts-retries",
            "tool-docker/project-layout",
            "tool-docker/image-hardening",
            "pov/mrjk-python-cli",
            "pov/mrjk-python-logging",
            "pov/mrjk-docs",
            "pov/mrjk-compose",
            "pov/mrjk-python-misc"
          ]
        },
        {
          "step_name": "Review",
          "description": "Review correctness, then audit the security of the boundaries.",
          "rules": [
            "role/reviewer",
            "review/thorough-code-review",
            "review/security-audit",
            "security/safe-defaults",
            "security/validate-external-input",
            "security/never-expose-secrets"
          ]
        },
        {
          "step_name": "Verify",
          "description": "Attack the change with tests until the boundaries and error paths are covered.",
          "rules": [
            "role/qa",
            "sdlc/reproduce-then-fix",
            "lang-python/testing-pytest",
            "tool-python/pytest",
            "testing/prefer-integration-tests",
            "testing/never-weaken-tests"
          ]
        },
        {
          "step_name": "Release",
          "description": "Document the change and confirm it is releasable.",
          "rules": [
            "role/tech-writer",
            "sdlc/release-checklist",
            "git/semantic-versioning",
            "git/support-branches"
          ]
        }
      ]
    }
  }
]
