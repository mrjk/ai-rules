[
  {
    "target": "Cursor",
    "ai_workflow": {
      "type": "standard",
      "preamble": "This repository is a library of composable AI agent rules for ai-rulesmith. Rules live under src/rules/, profiles under src/profiles/. Install with `task install`, validate with `task validate`, list rules with `task list`, rebuild agent files with `task build`. Rule pages on the docs site are generated at docs prep; do not edit the generated tree or README catalogs.",
      "before_start": [
        "workflow/understand-before-changing",
        "general/ask-when-blocked",
        "general/reviewable-increments",
        "meta/instruction-budget"
      ],
      "rules": [
        "meta/rule-placement",
        "meta/rule-authoring-style",
        "meta/capture-learnings",
        "meta/change-has-a-rule",
        "general/ascii-punctuation",
        "general/config-over-constants",
        "general/no-privileged-commands",
        "general/ignore-and-secrets-files",
        "tool-mise/pin-toolchain",
        "tool-task/taskfile-practices",
        "sdlc/pin-versions",
        "security/no-git-leakage",
        "sdlc/github-actions-hygiene",
        "git/feature-branch-workflow",
        "sdlc/dev-setup",
        "sdlc/repo-hygiene",
        "pov/mrjk-docs",
        {
          "slug": "sdlc/project-license",
          "vars": { "project_license": "GPL-3.0-or-later" }
        }
      ],
      "before_finish": [
        "general/concise-reporting",
        "workflow/verify-before-completing",
        "git/conventional-commits"
      ]
    }
  }
]
